# TikTok for Developers app (https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match Login Kit Redirect URI exactly (https; TikTok does not allow localhost)
TIKTOK_REDIRECT_URI=https://tok4k-menzies.netlify.app/auth/tiktok/callback

# 32+ random bytes for sealing session cookies (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Direct Post (posts straight to profile)
TIKTOK_SCOPES=user.info.basic,video.publish
